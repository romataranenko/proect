<Window x:Class="TaskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер задач" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель добавления задачи -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="txtTaskTitle" Width="200" Margin="0,0,10,0"
                    PlaceholderText="Название задачи"/>
            <TextBox x:Name="txtDescription" Width="300" Margin="10,0,10,0"
            PlaceholderText="Описание"/>
            <ComboBox x:Name="cmbPriority" Width="100" Margin="10,0,10,0">
                <ComboBoxItem Content="Высокий" Tag="1"/>
                <ComboBoxItem Content="Средний" Tag="2" IsSelected="True"/>
                <ComboBoxItem Content="Низкий" Tag="3"/>
            </ComboBox>
            <Button x:Name="btnAdd" Content="Добавить" Click="BtnAdd_Click" Width="80"/>
        </StackPanel>

        <!-- Список задач -->
        <DataGrid x:Name="dgvTasks" Grid.Row="1" AutoGenerateColumns="False"
                  Margin="0,10,0,10" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Выполнено" Binding="{Binding IsCompleted}"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="80"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding CreatedDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnMarkCompleted" Content="Отметить как выполненную"
                    Click="BtnMarkCompleted_Click" Margin="0,0,10,0"/>
            <Button x:Name="btnDelete" Content="Удалить" Click="BtnDelete_Click" Width="80"/>
        </StackPanel>
    </Grid>
</Window>